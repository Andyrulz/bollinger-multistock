{
  "name": "zerodha-trading-bot",
  "version": "1.0.0",
  "description": "Intraday trading bot for Zerodha using KiteConnect API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "generate-universe": "ts-node scripts/generate-universe.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "trading",
    "zerodha",
    "kiteconnect",
    "algorithmic-trading",
    "intraday"
  ],
  "author": "Trading Bot Developer",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "kiteconnect": "^5.1.0",
    "node-fetch": "^3.3.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
