{
  "templates": {
    "bollinger-stock-template": {
      "name": "Bollinger Band Stock Template",
      "description": "Template for scanner-deployed stock strategies",
      "timeframe": "5min",
      "riskPerTrade": 0.8,
      "maxPositions": 1,
      "config": {
        "period": 20,
        "stdDev": 2.0,
        "trailType": "percentage",
        "trailValue": 1.5
      }
    }
  },
  "strategies": [
    {
      "id": "bollinger-band-01", 
      "name": "5m option Buy: bollinger band entry and trail",
      "enabled": false,
      "description": "Manual NIFTY strategy (disabled during scanner mode). Bollinger Band strategy with trailing stop loss. Operates on 5-minute timeframe with 20-period bands and 2.0 standard deviation.",
      "timeframe": "5min",
      "instruments": ["NIFTY", "BANKNIFTY"],
      "riskPerTrade": 0.8,
      "maxPositions": 2,
      "config": {
        "period": 20,
        "stdDev": 2.0,
        "trailType": "percentage",
        "trailValue": 1.5,
        "riskReward": {
          "stopLoss": 2.0,
          "target": 4.0
        },
        "positionSizing": {
          "riskAmount": 10000,
          "riskPercentage": 2.0
        },
        "capitalAllocation": 200000
      }
    }
  ],
  "global": {
    "autoStart": false,
    "scannerMode": true,
    "healthCheckInterval": 30000,
    "logging": {
      "level": "info",
      "separateFiles": true
    },
    "riskManagement": {
      "maxDailyLoss": 50000,
      "maxDrawdown": 100000,
      "emergencyStop": true
    },
    "experimental": {
      "_comment": "Profitability Recovery Plan — May 15, 2026. Flip any flag to revert behavior without code change.",
      "enableShortEntries": false,
      "enablePremiumHardStop": false,
      "enableRsiConfirmationExit": false,
      "enableBreakoutNoFollowThroughExit": false,
      "enableExtendedGapTrap": false,
      "enableStaleBreakoutFilter": false,
      "enableWideRangeDayFilter": false,
      "enableExtremeNiftyRangeFilter": false,
      "enableVixLotReduction": false,
      "enableSameSlotPostLossLockout": true,
      "lunchBlockEndMinutesIst": 780,
      "minHoldingTimeMinutes": 20,
      "scannerKillSwitch": {
        "enabled": true,
        "maxConsecutiveLossesPerDay": 4
      },
      "_phase2_comment": "Pullback entry state machine. ACTIVE on Slots 2+3 (A/B vs Slot 1 immediate control). To roll out fully: pullbackSlots=[0,1,2]. To revert: enablePullbackEntry=false.",
      "enablePullbackEntry": true,
      "pullbackSlots": [1, 2],
      "pullbackArmTimeoutCandles": 4,
      "pullbackConfirmTimeoutCandles": 2,
      "pullbackAbandonOnExtensionPct": 0.015,
      "pullbackLongRsiThreshold": 60,
      "pullbackShortRsiThreshold": 40,
      "pullbackLongConfirmRsiThreshold": 60,
      "pullbackShortConfirmRsiThreshold": 40,
      "useStructuralStockStop": true,
      "structuralStopBufferPct": 0.0005,
      "_liquidity_comment": "Phase 2 fix Jun 2026 — executor liquidity gate now matches scanner: accept if (oi >= multiplier*lot_size) OR (vol >= minVolFallback). Was hardcoded oi>=10000 which rejected scanner-picked NIFTY 100 stocks like BOSCHLTD.",
      "liquidityOiMultiplier": 500,
      "liquidityMinVolFallback": 500
    }
  }
}