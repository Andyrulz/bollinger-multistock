# Swing is scanner-only and PAPER by default.
SWING_MODE=PAPER
SWING_MOMENTUM_DB=./data/momentum.db
SWING_MARKET_DB=./data/swing-market-data.db
SWING_SCANNER_CONFIG=./config/scanner.json
SWING_OUTPUT_DIR=./data/scans

# Read-only localhost gateway owned by the authenticated Bollinger process.
SWING_HOST=127.0.0.1
SWING_PORT=3002
BROKER_DATA_GATEWAY_URL=http://127.0.0.1:3003
