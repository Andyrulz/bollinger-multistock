{
  "name": "nse-swing-trading",
  "version": "0.1.0",
  "private": true,
  "description": "Independent NSE swing scanner and trading application",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js serve",
    "dev": "tsx src/index.ts serve",
    "build": "tsc",
    "clean": "rimraf dist",
    "scan": "tsx src/index.ts scan",
    "scan:as-of": "tsx src/index.ts scan --allow-stale",
    "qc:data": "tsx src/index.ts qc",
    "research:audit": "tsx src/research/cli.ts audit",
    "research:optimize": "tsx src/research/cli.ts optimize",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "24.7.2",
    "jest": "30.2.0",
    "rimraf": "6.0.1",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
