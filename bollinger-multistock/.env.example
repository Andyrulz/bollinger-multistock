# Internal shared-auth services. Keep these bound to loopback only.
BROKER_DATA_GATEWAY_PORT=3003
SWING_SERVICE_URL=http://127.0.0.1:3002
# Zerodha KiteConnect API Credentials
# Get these from: https://kite.trade/
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# OAuth Redirect URL (Required for HTTPS)
# For local development:
# REDIRECT_URL=http://localhost:3001/auth/callback
# For production VM with HTTPS nginx proxy:
REDIRECT_URL=https://98.70.40.23/tradebot-multistock/auth/callback

# Server Configuration
PORT=3001
BASE_PATH=/tradebot-multistock
NODE_ENV=production

# Logging Configuration
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly

# Timezone (Important for market hours)
TZ=Asia/Kolkata

# ========================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT
# ========================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your Zerodha API credentials
#
# 3. For VM deployment, copy to VM:
#    scp -i "C:\Users\aabishek\Downloads\nifty-trading-bot_key.pem" .env azureuser@98.70.40.23:~/tradebot-bollinger/
#
# 4. Restart the service:
#    pm2 restart ecosystem.config.js
#
# ========================================
# SECURITY NOTES
# ========================================
#
# • NEVER commit .env file to git
# • Keep API credentials secure
# • Use different credentials for dev/prod
# • Rotate API secrets periodically
# • Monitor API usage on Kite dashboard
#
